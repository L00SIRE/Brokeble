# Tab environment variables (PLAN §11). NAMES ONLY: never commit values.
# Local dev: copy the section for each app into apps/<app>/.env.local (git-ignored).
# Deployed: agent → `fly secrets set -a tab-agent`; venue/web → Vercel project env.

# ───────────── apps/agent (Fly app tab-agent) ─────────────
# HTTP port (8080)
PORT=
# Public origin of the agent, e.g. https://tab-agent.fly.dev
PUBLIC_BASE_URL=
# Web app origin for CORS on /join, /plans, /events
WEB_ORIGIN=
# Supabase session pooler :5432, role tab_agent
DATABASE_URL=
# photon | mock
MESSAGING_MODE=
# pho_sk_… (project:read, project:write, platforms:read, platforms:write)
PHOTON_API_KEY=
# pho_prj_…
PHOTON_PROJECT_ID=
# 2026-07-01
PHOTON_API_VERSION=
# anthropic | mock
LLM_MODE=
ANTHROPIC_API_KEY=
# live | cached | mock
PLANNER_MODE=
# capi_… CREAO account key (server only; never in the browser or CREAO Secrets)
CREAO_API_KEY=
# App ids from each CREAO agent page
CREAO_SCOUT_APP_ID=
CREAO_CONCIERGE_APP_ID=
# 32+ random chars; path segment of /creao/hook/:secret
CREAO_HOOK_SECRET=
# 32+ random chars; same value stored in CREAO Secrets
TAB_AGENT_TOKEN=
# live | mock
VENUE_MODE=
# Venue origin, e.g. https://<venue>.vercel.app
VENUE_BASE_URL=
# e.g. tab-agent-ed25519-1
TAP_KEY_ID=
# base64 of the PKCS8 PEM Ed25519 private key
TAP_PRIVATE_KEY_PEM_B64=
# HMAC secret shared with the venue (/venue/hook)
VENUE_HOOK_SECRET=
# Bearer for venue /ops/sweep
VENUE_OPS_KEY=
# HMAC key for payer_ref
PAYER_REF_SECRET=
# Read-only SSE key (console passes it as ?k=)
CONSOLE_KEY=
# Bearer for /ops/* (reset, replay, tap-test, seat release)
OPERATOR_KEY=
# 1 → vote 5 min, approve 10 min, re-ping at T-3 min
DEMO_TIMERS=
# Notion fallback only
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
# info
LOG_LEVEL=

# ───────────── apps/venue (Vercel project tab-venue, root apps/venue) ─────────────
# Stable production origin and host (Microform targetOrigins, TAP @authority; include the port locally)
VENUE_PUBLIC_URL=
VENUE_PUBLIC_HOST=
# Supabase transaction pooler :6543, role tab_venue, prepare:false
# DATABASE_URL=   (same name as the agent's; set per app)
# live | mock
CYBS_MODE=
# Cybersource REST shared secret (venue only, M1)
CYBS_MERCHANT_ID=
CYBS_KEY_ID=
CYBS_SECRET_KEY=
# apitest.cybersource.com
CYBS_RUN_ENV=
# {"<keyid>":{"kty":"OKP","crv":"Ed25519","x":"…"}} served at /keys/[keyid], labelled mock
TAP_KEY_DIRECTORY_JSON=
# e.g. https://tab-agent.fly.dev/venue/hook
AGENT_HOOK_URL=
# VENUE_HOOK_SECRET=, VENUE_OPS_KEY=   (same names and values as the agent's)
# Pay link lifetime in minutes (30)
PAY_LINK_TTL_MIN=

# ───────────── apps/web (Vercel project tab-web, root apps/web) ─────────────
# Public (baked into the bundle). The console key is never an env var here; it is passed as ?k=.
NEXT_PUBLIC_AGENT_URL=
NEXT_PUBLIC_VENUE_URL=

# ───────────── CREAO Secrets (account-wide; set in the CREAO UI, not here) ─────────────
# TAB_API_BASE=https://tab-agent.fly.dev and TAB_AGENT_TOKEN. Nothing else.

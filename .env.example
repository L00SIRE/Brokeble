# Tab environment variables (PLAN §11). NAMES ONLY: never commit values.
# Local dev: agent dev/seed:demo/db:migrate/creao:snapshot load the repo-root .env.local, then apps/agent/.env.local
# (later file wins; the shell wins over both). sim:plan reads only apps/agent/.env.local so it never hits the shared DB.
# Next.js apps read only apps/<app>/.env.local, so copy the venue/web sections there. All git-ignored.
# Deployed: agent → `fly secrets set -a tab-agent`; venue/web → Vercel project env.

# ───────────── apps/agent (Fly app tab-agent) ─────────────
# HTTP port (8080)
PORT=
# Public origin of the agent, e.g. https://tab-agent.fly.dev
PUBLIC_BASE_URL=
# Web app origin for CORS on /join, /plans, /events, /events/snapshot and /ops/*
WEB_ORIGIN=
# Supabase session pooler :5432, role tab_agent
DATABASE_URL=
# Local/CI only, never on Fly or Vercel: postgres-role URL that pnpm db:migrate applies db/migrations/*.sql to
OWNER_DATABASE_URL=
# Local/CI only: throwaway Postgres with the migrations applied; DB-gated tests run only when set (never prod data)
TEST_DATABASE_URL=
# photon | mock
MESSAGING_MODE=
# pho_sk_… (project:read, project:write, platforms:read, platforms:write)
PHOTON_API_KEY=
# pho_prj_…
PHOTON_PROJECT_ID=
# 2026-07-01
PHOTON_API_VERSION=
# anthropic | mock
LLM_MODE=
ANTHROPIC_API_KEY=
# live | cached | mock
PLANNER_MODE=
# capi_… CREAO account key (server only; never in the browser or CREAO Secrets)
CREAO_API_KEY=
# App ids from each CREAO agent page
CREAO_SCOUT_APP_ID=
CREAO_CONCIERGE_APP_ID=
# 32+ random chars; path segment of /creao/hook/:secret
CREAO_HOOK_SECRET=
# 32+ random chars; same value stored in CREAO Secrets
TAB_AGENT_TOKEN=
# 0 (default); 1 only while building the CREAO agents (accepts the all-zero test plan_ref on /agent/*)
AGENT_API_ALLOW_TEST_REF=
# live | mock
VENUE_MODE=
# Venue production origin, e.g. https://<venue>.vercel.app (= the venue's VENUE_PUBLIC_URL; TAP @authority is its host)
VENUE_BASE_URL=
# e.g. tab-agent-ed25519-1
TAP_KEY_ID=
# base64 of the PKCS8 PEM Ed25519 private key
TAP_PRIVATE_KEY_PEM_B64=
# HMAC secret shared with the venue (/venue/hook)
VENUE_HOOK_SECRET=
# Bearer for venue /ops/sweep
VENUE_OPS_KEY=
# HMAC key for payer_ref
PAYER_REF_SECRET=
# Read-only SSE key (console passes it as ?k=)
CONSOLE_KEY=
# Bearer for /ops/* (reset, replay, tap-test, seat release)
OPERATOR_KEY=
# 1 → vote 5 min, approve 10 min, re-ping at T-3 min
DEMO_TIMERS=
# PII (Fly secret / .env.local only): JSON [{"phone_e164":"+1…","first_name":"…"}]
DEMO_TEAM=
# Demo plan code, reused on every Reset (4821)
DEMO_CODE=
# Typing-indicator refresh interval in ms (5000 until A's S4 result)
TYPING_REFRESH_MS=
# Voice (only if voice is go): 1 makes the four ELEVENLABS_* values required
VOICE_ENABLED=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Notion fallback only
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
# info
LOG_LEVEL=

# ───────────── apps/venue (Vercel project tab-venue, root apps/venue) ─────────────
# Stable production origin and host (Microform targetOrigins, TAP @authority; include the port locally).
# The agent's VENUE_BASE_URL must be this same origin: the signer uses new URL(VENUE_BASE_URL).host as @authority.
VENUE_PUBLIC_URL=
VENUE_PUBLIC_HOST=
# Supabase transaction pooler :6543, role tab_venue, prepare:false
# DATABASE_URL=   (same name as the agent's; set per app: apps/venue/.env.local and Vercel)
# Repo-root .env.local only: the tab_venue URL kept beside the agent's DATABASE_URL; copy it into apps/venue/.env.local
# as DATABASE_URL. Nothing reads this name directly.
VENUE_DATABASE_URL=
# live | mock
CYBS_MODE=
# Cybersource REST shared secret (venue only, M1)
CYBS_MERCHANT_ID=
CYBS_KEY_ID=
CYBS_SECRET_KEY=
# apitest.cybersource.com | testrest.cybersource.com (public testrest merchant)
CYBS_RUN_ENV=
# jwt (default; testrest shared secret) | http_signature
CYBS_AUTH_TYPE=
# {"<keyid>":{"kty":"OKP","crv":"Ed25519","x":"…"}} served at /keys/[keyid], labelled mock
TAP_KEY_DIRECTORY_JSON=
# e.g. https://tab-agent.fly.dev/venue/hook
AGENT_HOOK_URL=
# VENUE_HOOK_SECRET=, VENUE_OPS_KEY=   (same names and values as the agent's)
# Pay link lifetime in minutes (1440; token expiry = least(now()+TTL, deadline_at), so in practice the deadline)
PAY_LINK_TTL_MIN=

# ───────────── apps/web (Vercel project tab-web, root apps/web) ─────────────
# Public (baked into the bundle). The console key is never an env var here; it is passed as ?k=.
NEXT_PUBLIC_AGENT_URL=
NEXT_PUBLIC_VENUE_URL=

# ───────────── CREAO Secrets (account-wide; set in the CREAO UI, not here) ─────────────
# TAB_API_BASE=https://tab-agent.fly.dev and TAB_AGENT_TOKEN. Nothing else.

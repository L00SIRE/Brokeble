{
  "name": "@tab/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "sim:plan": "tsx --env-file-if-exists=.env.local scripts/simPlan.ts",
    "seed:demo": "tsx --env-file-if-exists=.env.local scripts/seedDemo.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "creao:snapshot": "tsx --env-file-if-exists=.env.local scripts/creao-snapshot.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@hono/node-server": "2.1.5",
    "@notionhq/client": "5.27.1",
    "@photon-ai/api": "0.5.0",
    "@tab/shared": "workspace:*",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
